  m_Script: {fileID: 11500000, guid: 08d18cca6f19690448d81eb0c24d5ca0, type: 3}
  m_Name: Mission_Before_03
  m_EditorClassIdentifier: 
  missionId: before_03
  missionName: Secure the appliences
  missionDescription: Securing the Appliences
  missionIcon: {fileID: 0}
  phase: 0
  missionSceneName: BeforeMission
  isLocked: 1
  requiredMissionId: before_02
  sortOrder: 3
  tasks:
  - taskId: before_03_secure_appliances
    taskName: Secure Appliances
    taskDescription: Move all critical appliances above the projected flood level.
    taskIcon: {fileID: 0}
    taskType: 6
    isOptional: 0
    showDialogueOnStart: 1
    startDialogue:
    - Water can rise fast. Lift heavy appliances above the flood line to prevent
      damage.
    - Before you begin, answer this quick question.
    startDialogueRich:
    - characterId: professor_lingap
      characterName: Professor Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Water can rise fast. Lift heavy appliances above the flood line to
        prevent damage.
    - characterId: professor_lingap
      characterName: Professor Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Approach the microwave on the floor.
    showDialogueOnComplete: 0
    completeDialogue:
    - Great! Now raise each appliance onto a higher surface above the blue line.
    completeDialogueRich:
    - characterId: professor_lingap
      characterName: Professor Lingap
      side: 1
      expressionId: approved
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Great! You kept the appliances above the flood line.
    arScanForPlaneDialogueRich:
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Move your device slowly and point it at the floor.
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: We need to detect a flat surface where we can place the house.
    arTapToPlaceDialogueRich:
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 2
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Great, I can see a surface now.
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 2
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Tap on the detected area to place the house interior.
    arGuidanceDialogueRich:
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Tap an appliance, then tap a higher surface above the blue flood line.
    - characterId: professor_lingap
      characterName: Prof. Lingap
      side: 1
      expressionId: explaining
      portraitOverride: {fileID: 0}
      backgroundSprite: {fileID: 0}
      clearBackground: 0
      message: Make sure every important appliance is raised before the water rises.
    taskStartQuiz:
      question: 
      options:
      - 
      - 
      - 
      wrongOptionFeedback:
      - 
      - 
      - 
      correctOptionIndex: 0
      optionSprites:
      - {fileID: 0}
      - {fileID: 0}
      - {fileID: 0}
      placeholderSprite: {fileID: 0}
      questionCharacterId: 
      questionExpressionId: 
      questionPortraitOverride: {fileID: 0}
      correctAnswerDialogue: []
      correctAnswerDialogueRich: []
    objectives: []
  introDialogue:
  - hello
  introDialogueRich:
  - characterId: professor_lingap
    characterName: Prof. Lingap
    side: 3
    expressionId: center
    portraitOverride: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 60c41380052c50141aefbf4e5b49bbd5, type: 3}
    clearBackground: 0
    message: Now, our focus shifts to safety; for only by protecting the equipment
      can we ensure that wear and tear remain at zero to minimal levels.
  startQuiz:
    question: When leaving the house or evacuating what is the best way to do?
    options:
    - Just leave the appliences
    - 'Secure important appliences '
    - Hide the appliences
    wrongOptionFeedback:
    - mali 0
    - "mali 1\t"
    - malo2
